# ---------------------------------------------------------------------------
# Markdown: nothing is committed except README.md.
# Planning docs, findings write-ups and notes stay local until the owner says
# otherwise. To commit one deliberately: git add -f path/to/file.md
# ---------------------------------------------------------------------------
*.md
!README.md

# ---------------------------------------------------------------------------
# Generated notebook artefacts
# Figures, tables and models are reproducible from the notebooks. Remove a line
# here if a specific artefact should ship as research evidence.
# ---------------------------------------------------------------------------
notebooks/outputs/
*.pkl
*.joblib

# ---------------------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Environments
# The environment is defined by environment.yml, which lives one level up in
# the project root. Never commit a materialised env.
# ---------------------------------------------------------------------------
.venv/
venv/
env/
.conda/
.env

# ---------------------------------------------------------------------------
# Data — belt and braces.
# dataset/ currently sits outside this repo, but nothing resembling the panel,
# the feature matrix or the quarantined audit labels should ever land here by
# accident. t3_audit_labels carries the population column that doc 08 prohibits
# from reaching any model.
# ---------------------------------------------------------------------------
dataset/
data/
*.csv
*.jsonl
*.parquet
*t3_audit_labels*

# ---------------------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
