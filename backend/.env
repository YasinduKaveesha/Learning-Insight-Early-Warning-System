# Component 3 backend -- LOCAL DEVELOPMENT. Never commit this file (backend/.gitignore:4).
#
# DATA lives in the LOCAL Docker Postgres (D25). AUTH comes from the student app's
# Supabase project. Those are deliberately two different places: the Supabase project is
# shared with the student-app team and holds live data, so Component 3 never writes to it.

APP_ENV=local
API_PORT=8100
LOG_LEVEL=INFO

# upadya_demo on the DIRECT port (55432 -> container 5432), published by
# backend/docker/compose.c3-test-db.yaml.
#
# THREE DATABASES, AND THEY ARE NOT INTERCHANGEABLE (revises D25):
#   upadya       the student-app team's dev database. READ-ONLY to us; t3_ chain sits at 0006.
#   upadya_test  the TEST database. The live suite seeds its own fixtures here, including
#                t3_demo_learner_map rows for STU-0001..STU-0300. Demo data placed here
#                collides on that UNIQUE constraint and breaks 18 live tests -- which is
#                exactly what happened, and why upadya_demo exists.
#   upadya_demo  the integrated demo. teacher01, six classrooms, 120 learners, one pipeline
#                run. Both APIs point here; the test suite never touches it.
# 2026-09-16: the shared database moved to Supabase, so the demo runs from any machine.
# SESSION pooler (port 5432), not the transaction pooler (6543): prepared statements work,
# and it is the only IPv4 route on the free plan -- db.<ref>.supabase.co is IPv6-only.
# The previous local value, kept for a quick switch back if the network is unreliable:
#   DATABASE_URL=postgresql://upadya:local-development-only@127.0.0.1:55432/upadya_demo
DATABASE_URL=postgresql://postgres.hliyqkmmghheoxvdxjbv:SLpredetor2027@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# compose.yaml substitutes this for the container (the host value above would be wrong
# inside it if we were still on local Docker; pointing both at Supabase keeps them equal).
T3_DOCKER_DATABASE_URL=postgresql://postgres.hliyqkmmghheoxvdxjbv:SLpredetor2027@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# DATABASE_URL_POOLED is deliberately UNSET (2026-09-16). Supabase's transaction pooler
# (port 6543) broke the API: asyncpg still names its prepared statements with the cache
# off, and Supavisor's transaction mode collides on those names ("prepared statement
# already exists"), failing requests intermittently. It was also slower here than the
# session pooler (13 s vs 7 s for /home). The API therefore uses DATABASE_URL, the session
# pooler on 5432, which has neither problem.

# Vite's default port, plus the 127.0.0.1:5273 fallback the dev server actually
# uses when 5173 is unavailable (Windows reserves it on some machines: vite exits
# with EACCES). 127.0.0.1 and localhost are DISTINCT browser origins, so both the
# host and the port have to be listed explicitly. The validator rejects "*" and
# rejects an empty list.
# 2026-10-08: Windows reserves TCP 5135-5834 on this machine (netsh excludedportrange),
# so BOTH 5173 and 5273 fail with EACCES. The dev server runs on 4173 instead.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5273,http://127.0.0.1:4173,http://localhost:4173

# Verified 2026-09-13: this project's JWKS serves an ES256 key, which is inside the
# backend's ALLOWED_ALGORITHMS. A project still on the legacy HS256 secret would have every
# token rejected.
SUPABASE_URL=https://hliyqkmmghheoxvdxjbv.supabase.co
SUPABASE_JWT_ISSUER=https://hliyqkmmghheoxvdxjbv.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://hliyqkmmghheoxvdxjbv.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_CACHE_TTL_SECONDS=300

T3_MODEL_ARTEFACT_PATH=./artefacts
T3_ACTIVE_MODEL_VERSION=1.0.0

# D29: teacher01 signs in with a real credential and resolves through the "real" principal
# path. The anonymous / t3_teacher_bindings machinery stays built, tested and DISARMED.
T3_DEMO_MODE=false

# ---- Seeder only (scripts/seed_demo_tenancy.py). Not read by the API. ----
SUPABASE_SERVICE_ROLE_KEY=sb_secret_8oeC3lqbf_myDFcaOzhvig_K0N3jnYr
SUPABASE_PUBLISHABLE_KEY=sb_publishable_3XT0BdqPEJA1JXDAPxC8kQ_etlF6dpt
T3_DEMO_TEACHER_EMAIL=yass@gmail.com
T3_DEMO_TEACHER_PASSWORD=12345678
T3_DEMO_TEACHER_NAME=Teacher01
T3_STUDENT_API_BASE_URL=http://127.0.0.1:8000

# Shared password for the 120 throwaway demo learner accounts.
T3_DEMO_LEARNER_PASSWORD=c3demo-learner-2026

# Load the active run into memory as the API starts, so the first page is not the slow one.
T3_CACHE_WARM_ON_STARTUP=true


