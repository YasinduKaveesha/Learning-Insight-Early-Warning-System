# Copy to .env and fill in real values. Never commit a real .env.
# Component 3 uses the SAME Supabase project as the student app (Upadya/Dev/backend/.env) for
# DATABASE_URL and the SUPABASE_* values -- copy them, do not create a second project.

APP_ENV=local
API_PORT=8100

DATABASE_URL=postgresql://user:password@localhost:5432/placeholder
LOG_LEVEL=INFO

# The dashboard origin. Never "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_CACHE_TTL_SECONDS=300

# Versioned artefact store root -- backend/artefacts/<model_version>/<artefact filename>.
T3_MODEL_ARTEFACT_PATH=./artefacts
T3_ACTIVE_MODEL_VERSION=1.0.0

# Load the active pipeline run into memory as the API starts (recommended with a hosted database).
T3_CACHE_WARM_ON_STARTUP=true
