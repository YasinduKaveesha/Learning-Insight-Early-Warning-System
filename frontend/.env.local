# Local dev. Gitignored by frontend/.gitignore ("*.local").
#
# VITE_USE_MOCK=false turns on REAL Supabase auth (D29: email/password, never
# anonymous). Set it back to true to run the whole app with no Supabase project
# at all -- that is the rollback path, and it must keep working.
VITE_USE_MOCK=false

VITE_SUPABASE_URL=https://hliyqkmmghheoxvdxjbv.supabase.co
# The PUBLISHABLE key. Browser-safe by design -- it is meant to ship to the
# client. The secret key never appears in this file.
VITE_SUPABASE_ANON_KEY=sb_publishable_3XT0BdqPEJA1JXDAPxC8kQ_etlF6dpt

# Where the C3 API lives. Not consumed yet -- W4 (httpClient) is the work order
# that introduces the first fetch. Recorded now so it is one less thing then.
VITE_API_BASE_URL=http://127.0.0.1:8100
VITE_STUDENT_APP_BASE_URL=http://127.0.0.1:8000
