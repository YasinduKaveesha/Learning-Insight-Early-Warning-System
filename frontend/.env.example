# Component 3 Teacher Dashboard — frontend environment
#
# ---------------------------------------------------------------------------
# ROLLBACK / DEMO PATH (frontend_plan §11.0 gate 5, §11.1 gate 3)
# ---------------------------------------------------------------------------
# With VITE_USE_MOCK=true (or with NO Supabase project configured at all),
# the whole app runs against MockClient and the login screen is bypassed.
# This is the path that must keep working if the backend is down.
VITE_USE_MOCK=true

# ---------------------------------------------------------------------------
# REAL BACKEND PATH
# ---------------------------------------------------------------------------
# Set VITE_USE_MOCK=false and fill these in to sign in against the real
# Supabase project. Email/password sign-in ONLY (decision D29) — anonymous
# sign-in is deliberately never used.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — live end-to-end auth gates (frontend_plan §11.0 gates 7-8).
# These tests SKIP unless all three are set. They need a running backend and
# a real teacher01 credential, neither of which exists yet.
# ---------------------------------------------------------------------------
# T3_E2E_SUPABASE_URL=
# T3_E2E_SUPABASE_ANON_KEY=
# T3_E2E_TEACHER_EMAIL=
# T3_E2E_TEACHER_PASSWORD=
